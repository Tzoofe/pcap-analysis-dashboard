# Copy this file to ".env" and fill in your own values. Never commit .env.
# Get a free Gemini API key at https://aistudio.google.com/apikey
# (Optional: the key can also be typed into the dashboard instead.)
GEMINI_API_KEY=
# Optional: which Gemini model to use (default: gemini-3.5-flash).
# It can also be changed in the dashboard's "Gemini model" list.
GEMINI_MODEL=gemini-3.5-flash
